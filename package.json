{
  "name": "mosaic-screen",
  "version": "2.0.0",
  "description": "Controller for single line neopixel \"snake\" wrapped display via GPIO",
  "main": "index.js",
  "scripts": {
    "start": "sudo node index",
    "dev": "node index",
    "setup": "node src/utils/setup.js",
    "generate-fonts": "node src/utils/generate-font-pngs.js",
    "test": "node tests/canvas.test.js && node tests/font.test.js && node tests/text-overlay.test.js && node tests/color-alpha.test.js",
    "test:canvas": "node tests/canvas.test.js",
    "test:font": "node tests/font.test.js",
    "test:overlay": "node tests/text-overlay.test.js",
    "test:color": "node tests/color-alpha.test.js",
    "service:install": "sudo node src/utils/service.js install",
    "service:uninstall": "sudo node src/utils/service.js uninstall",
    "service:start": "sudo systemctl start mosaic-screen",
    "service:stop": "sudo systemctl stop mosaic-screen",
    "service:restart": "sudo systemctl restart mosaic-screen",
    "service:status": "sudo systemctl status mosaic-screen",
    "service:logs": "sudo journalctl -u mosaic-screen -f",
    "service:enable": "sudo systemctl enable mosaic-screen",
    "service:disable": "sudo systemctl disable mosaic-screen"
  },
  "author": "techninja",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.1",
    "rpi-ws281x-native": "^1.0.4",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  }
}
